{
  "ConnectionStrings": {
    "BeaconDb": "Server=(localdb)\\MSSQLLocalDB;Database=BeaconDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "Redis": "localhost:6379,abortConnect=false,connectTimeout=1000,connectRetry=1,syncTimeout=1000"
  },
  "Jwt": {
    "Issuer": "Beacon",
    "Audience": "BeaconApi",
    "SigningKey": "dev-only-signing-key-do-not-use-in-production-replace-via-key-vault-at-deploy-time",
    "ExpiryMinutes": 60
  },
  "Claude": {
    "ApiKey": "",
    "BaseUrl": "https://api.anthropic.com",
    "Model": "claude-sonnet-5",
    "MaxTokens": 1024
  },
  "ItsmBridge": {
    "BaseUrl": "http://localhost:8080"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/beacon-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
